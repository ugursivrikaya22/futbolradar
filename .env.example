# Keep API keys empty in git. Set real values only in Vercel Environment Variables.

# Public Google Analytics 4 measurement ID. Replace the placeholder when ready.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Backward-compatible football-data.org variables
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_COMPETITION_CODE=TSL

# Preferred football-data.org variables
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION_CODE=TSL

# API-Football / API-Sports variables
# Each of these accepts a couple of common naming variants (with or without
# an underscore between "API" and "FOOTBALL") so a differently-named Vercel
# variable still activates the live provider instead of silently falling
# back to mock data:
#   APIFOOTBALL_API_KEY      / API_FOOTBALL_API_KEY / APIFOOTBALL_KEY /
#                               API_FOOTBALL_KEY / API_SPORTS_API_KEY / APISPORTS_API_KEY
#   APIFOOTBALL_LEAGUE_ID    / API_FOOTBALL_LEAGUE_ID / APIFOOTBALL_LEAGUEID / API_SPORTS_LEAGUE_ID
#   APIFOOTBALL_API_BASE_URL / API_FOOTBALL_API_BASE_URL / APIFOOTBALL_BASE_URL / API_FOOTBALL_BASE_URL
#   APIFOOTBALL_SEASON       / API_FOOTBALL_SEASON
#   APIFOOTBALL_COUNTRY      / API_FOOTBALL_COUNTRY
APIFOOTBALL_API_KEY=
APIFOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_LEAGUE_ID=
APIFOOTBALL_SEASON=2026
APIFOOTBALL_COUNTRY=Turkey

# Provider routing
FOOTBALL_PRIMARY_PROVIDER=api-football
# api-football returns all competitions for a date-only matches request.
# football-data remains useful for one configured competition (TSL).
FOOTBALL_MATCH_PROVIDER=api-football
FOOTBALL_PLAYER_PROVIDER=api-football
FOOTBALL_TRANSFER_PROVIDER=api-football
FOOTBALL_TEAM_PROVIDER=api-football

# TheSportsDB (fikstür takvimi senkronu - scripts/sync-fixture-calendar.mjs)
# Ücretsiz/anahtarsız çalışır; boş bırakılırsa "3" test anahtarı kullanılır.
# Daha yüksek hız limiti gerekirse Patreon anahtarı buraya girilir.
THESPORTSDB_API_KEY=
