# Keep API keys empty in git. Set real values only in Vercel Environment Variables.

# Public analytics identifiers. Set these in Vercel Production variables.
# Example formats are shown only as comments; never invent campaign IDs.
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PAGE_VIEW_LABEL=
GOOGLE_ADS_MATCH_CLICK_LABEL=

# Backward-compatible football-data.org variables
FOOTBALL_API_PROVIDER=football-data
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_COMPETITION_CODE=TSL

# Preferred football-data.org variables
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION_CODE=TSL

# ---------------------------------------------------------------------------
# API-Football / API-Sports
#
# Kurulumun tamamı: docs/api-football-setup.md
# Doğrulama:        node scripts/preflight-api-football.mjs
#
# ZORUNLU OLAN TEK DEĞER APIFOOTBALL_API_KEY'dir. Diğerleri boş bırakılabilir.
#
# Anahtar üç ayrı ortama ayrı ayrı tanımlanır ve biri diğerini görmez:
#   Vercel         → Settings → Environment Variables (Production + Preview)
#   GitHub Actions → Settings → Secrets and variables → Actions
#   Yerel          → bu dosyayı .env olarak kopyala (.env git'e girmez)
# Kadro senkronu CI'da koştuğu için asıl gereken yer GitHub Actions'tır;
# yalnızca Vercel'de tanımlı bir anahtar kadroları doldurmaz.
#
# Her ayar birkaç yaygın yazım varyantını da kabul eder, böylece farklı adla
# tanımlanmış bir değişken canlı sağlayıcıyı sessizce devre dışı bırakmaz:
#   APIFOOTBALL_API_KEY      / API_FOOTBALL_API_KEY / APIFOOTBALL_KEY /
#                               API_SPORTS_API_KEY / APISPORTS_API_KEY
#   (API_FOOTBALL_KEY ARTIK KABUL EDİLMİYOR - eski ad kaldırıldı.)
#   APIFOOTBALL_LEAGUE_ID    / API_FOOTBALL_LEAGUE_ID / APIFOOTBALL_LEAGUEID / API_SPORTS_LEAGUE_ID
#   APIFOOTBALL_API_BASE_URL / API_FOOTBALL_API_BASE_URL / APIFOOTBALL_BASE_URL / API_FOOTBALL_BASE_URL
#   APIFOOTBALL_SEASON       / API_FOOTBALL_SEASON
#   APIFOOTBALL_COUNTRY      / API_FOOTBALL_COUNTRY
# ---------------------------------------------------------------------------

# Zorunlu. 32 onaltılık karakter, tırnaksız ve boşluksuz.
APIFOOTBALL_API_KEY=

APIFOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# Boş bırakılabilir: anahtar varsa Süper Lig'in kimliği sağlayıcının /leagues
# uç noktasından çözülüp data/api-football-league.json'a önbelleklenir.
# Sağlayıcı birden fazla aday döndürürse tahmin edilmez; çözümleme durur ve
# adaylar listelenir — o durumda doğru kimliği buraya yazın.
APIFOOTBALL_LEAGUE_ID=

# Boş bırakılabilir: tarihten türetilir. Avrupa sezonu başladığı yılla anılır
# (temmuz-aralık o yıl, ocak-haziran bir önceki yıl), yani 2026-27 sezonu için
# 2026. Buraya yazılan değer türetmeyi ezer.
APIFOOTBALL_SEASON=2026

APIFOOTBALL_COUNTRY=Turkey

# Provider routing
FOOTBALL_PRIMARY_PROVIDER=api-football
# api-football returns all competitions for a date-only matches request.
# football-data remains useful for one configured competition (TSL).
FOOTBALL_MATCH_PROVIDER=api-football
FOOTBALL_PLAYER_PROVIDER=api-football
FOOTBALL_TRANSFER_PROVIDER=api-football
FOOTBALL_TEAM_PROVIDER=api-football

# TheSportsDB (fikstür takvimi senkronu - scripts/sync-fixture-calendar.mjs)
# Ücretsiz/anahtarsız çalışır; boş bırakılırsa "3" test anahtarı kullanılır.
# Daha yüksek hız limiti gerekirse Patreon anahtarı buraya girilir.
THESPORTSDB_API_KEY=

# Google Search Console (Search Demand Engine - scripts/fetch-search-console.mjs)
# Kurulum adımları: docs/search-demand-engine.md. Servis hesabı e-postası
# Search Console'a kullanıcı olarak eklenmeli. Anahtar tek satır (\n kaçışlı)
# ya da base64 olarak girilebilir; ikisi de boşsa script veri ÜRETMEZ,
# "bağlı değil" durumu yazar.
GSC_SITE_URL=
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_PRIVATE_KEY_BASE64=

# Optional JSON array of trusted RSS/Atom feed definitions. When empty, the
# scheduler uses built-in official-club/TFF/UEFA and trusted-media queries.
# Keep the JSON on one line when configured as a GitHub Actions secret.
FOOTBALL_NEWS_FEEDS=
