{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-continue-build.mjs",
  "installCommand": "",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "futbolradar.com"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "futbolradar.com.tr"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.futbolradar.com.tr"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/oyuncular/edina-dzeko",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    },
    {
      "source": "/oyuncular/edina-dzeko.html",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    },
    {
      "source": "/players/position/forvet.html",
      "destination": "/oyuncular/forvetler.html",
      "permanent": true
    },
    {
      "source": "/players/league/super-lig.html",
      "destination": "/super-lig-oyuncu-radari.html",
      "permanent": true
    },
    {
      "source": "/mac-analizi-galatasaray-fenerbahce.html",
      "destination": "/derbi-radari.html",
      "permanent": true
    },
    {
      "source": "/takim-galatasaray.html",
      "destination": "/galatasaray-form-durumu.html",
      "permanent": true
    },
    {
      "source": "/super-lig-form-tablosu.html",
      "destination": "/super-lig-form-durumu.html",
      "permanent": true
    },
    {
      "source": "/mac-analizi/galatasaray-fenerbahce",
      "destination": "/derbi-radari.html",
      "permanent": true
    },
    {
      "source": "/takim/galatasaray",
      "destination": "/galatasaray-form-durumu.html",
      "permanent": true
    },
    {
      "source": "/super-lig-form-tablosu",
      "destination": "/super-lig-form-durumu.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/oyuncular/forvetler",
      "destination": "/oyuncular/forvetler.html"
    },
    {
      "source": "/oyuncular/kaleciler",
      "destination": "/oyuncular/kaleciler.html"
    },
    {
      "source": "/oyuncular/defanslar",
      "destination": "/oyuncular/defanslar.html"
    },
    {
      "source": "/oyuncular/orta-sahalar",
      "destination": "/oyuncular/orta-sahalar.html"
    },
    {
      "source": "/oyuncular/genc-yetenekler",
      "destination": "/oyuncular/genc-yetenekler.html"
    },
    {
      "source": "/oyuncular/en-iyi-oyuncular",
      "destination": "/oyuncular/en-iyi-oyuncular.html"
    },
    {
      "source": "/oyuncu-karsilastirmalari",
      "destination": "/oyuncu-karsilastirmalari.html"
    },
    {
      "source": "/oyuncular/:slug",
      "destination": "/oyuncular/:slug.html"
    },
    {
      "source": "/karsilastirma/:slug",
      "destination": "/karsilastirma/:slug.html"
    },
    {
      "source": "/maclar/:date",
      "destination": "/maclar/:date/index.html"
    },
    {
      "source": "/mac/:slug",
      "destination": "/mac/:slug/index.html"
    },
    {
      "source": "/turnuva/:slug",
      "destination": "/turnuva/:slug/index.html"
    },
    {
      "source": "/lig/:slug",
      "destination": "/lig/:slug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/score-home.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/widgets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=180"
        }
      ]
    },
    {
      "source": "/page.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/og/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/maclar/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=180"
        }
      ]
    },
    {
      "source": "/mac/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=900"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
