{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-continue-build.mjs",
  "installCommand": "",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "futbolradar.com"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "futbolradar.com.tr"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.futbolradar.com.tr"
        }
      ],
      "destination": "https://www.futbolradar.com/:path*",
      "permanent": true
    },
    {
      "source": "/oyuncular/edina-dzeko",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    },
    {
      "source": "/oyuncular/edina-dzeko.html",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    },
    {
