{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel-continue-build.mjs",
  "installCommand": "",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/oyuncular/edina-dzeko",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    },
    {
      "source": "/oyuncular/edina-dzeko.html",
      "destination": "/oyuncular/edin-dzeko.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/oyuncular/forvetler",
      "destination": "/oyuncular/forvetler.html"
    },
    {
      "source": "/oyuncular/kaleciler",
      "destination": "/oyuncular/kaleciler.html"
    },
    {
      "source": "/oyuncular/defanslar",
      "destination": "/oyuncular/defanslar.html"
    },
    {
      "source": "/oyuncular/orta-sahalar",
      "destination": "/oyuncular/orta-sahalar.html"
    },
    {
      "source": "/oyuncular/genc-yetenekler",
      "destination": "/oyuncular/genc-yetenekler.html"
    },
    {
      "source": "/oyuncular/en-iyi-oyuncular",
      "destination": "/oyuncular/en-iyi-oyuncular.html"
    },
    {
      "source": "/oyuncu-karsilastirmalari",
      "destination": "/oyuncu-karsilastirmalari.html"
    },
    {
      "source": "/oyuncular/:slug",
      "destination": "/oyuncular/:slug.html"
    },
    {
      "source": "/karsilastirma/:slug",
      "destination": "/karsilastirma/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
