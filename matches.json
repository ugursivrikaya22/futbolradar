:root {
  --bg: #07111f;
  --bg-2: #0c1828;
  --panel: #101f33;
  --panel-2: #132640;
  --text: #edf4ff;
  --muted: #9fb0c8;
  --line: rgba(255,255,255,.10);
  --accent: #4ade80;
  --accent-2: #38bdf8;
  --warning: #fbbf24;
  --danger: #fb7185;
  --shadow: 0 24px 60px rgba(0,0,0,.30);
  --radius: 22px;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}
a { color: inherit; text-decoration: none; }
.container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(7,17,31,.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.nav-wrap { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 24px; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 900; letter-spacing: -.03em; font-size: 1.15rem; }
.brand-mark {
  display: inline-grid; place-items: center;
  width: 38px; height: 38px; border-radius: 12px;
  color: #07111f; background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.main-nav { display: flex; align-items: center; gap: 18px; color: var(--muted); font-weight: 700; font-size: .94rem; }
.main-nav a:hover { color: var(--text); }
.hero {
  padding: 78px 0;
  background:
    radial-gradient(circle at 20% 0%, rgba(74,222,128,.22), transparent 34%),
    radial-gradient(circle at 80% 20%, rgba(56,189,248,.17), transparent 32%),
    linear-gradient(180deg, #07111f 0%, #0a1524 100%);
}
.hero-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 34px; align-items: center; }
.eyebrow { margin: 0 0 10px; color: var(--accent); text-transform: uppercase; letter-spacing: .12em; font-size: .78rem; font-weight: 900; }
h1, h2, h3 { line-height: 1.12; letter-spacing: -.045em; margin: 0 0 14px; }
h1 { font-size: clamp(2.4rem, 6vw, 5.2rem); max-width: 820px; }
h2 { font-size: clamp(1.65rem, 3vw, 2.45rem); }
h3 { font-size: 1.25rem; }
.hero-text, .lead { color: var(--muted); font-size: 1.13rem; max-width: 720px; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
.btn { display: inline-flex; align-items: center; justify-content: center; padding: 13px 18px; border-radius: 999px; font-weight: 900; border: 1px solid var(--line); }
.btn.primary { background: var(--accent); color: #07111f; border-color: transparent; }
.btn.secondary { background: rgba(255,255,255,.05); color: var(--text); }
.hero-card, .panel, .match-card, .match-summary-card, .ad-box {
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.hero-card { padding: 28px; }
.card-kicker, .team-label { display: inline-block; color: var(--muted); font-weight: 800; font-size: .82rem; margin-bottom: 8px; }
.score-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 22px 0; }
.score-row div { padding: 18px; background: rgba(255,255,255,.05); border-radius: 18px; }
.score-row strong { display: block; font-size: 2.35rem; line-height: 1; }
.score-row span, .mini-note { color: var(--muted); }
.text-link { color: var(--accent); font-weight: 900; }
.section { padding: 62px 0; }
.alt-bg { background: var(--bg-2); }
.section-head { display: flex; justify-content: space-between; align-items: end; gap: 18px; margin-bottom: 26px; }
.section-head.compact { margin-bottom: 18px; }
.date-pill, .pill { padding: 8px 12px; border-radius: 999px; background: rgba(74,222,128,.12); color: var(--accent); font-weight: 900; }
.match-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.match-card { padding: 22px; }
.match-meta { display: flex; justify-content: space-between; color: var(--muted); font-size: .87rem; font-weight: 800; margin-bottom: 12px; }
.momentum-bars { display: grid; gap: 12px; margin: 18px 0; }
.momentum-bars > div { display: grid; grid-template-columns: 96px 1fr 34px; gap: 10px; align-items: center; color: var(--muted); font-size: .9rem; }
.bar { height: 9px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
.bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: inherit; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
.tag-row span { padding: 7px 10px; border-radius: 999px; background: rgba(255,255,255,.07); font-weight: 800; font-size: .82rem; }
.tag-row .danger { color: var(--danger); }
.tag-row .warning { color: var(--warning); }
.tag-row .success { color: var(--accent); }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.panel { padding: 26px; }
.team-list { display: grid; gap: 12px; }
.team-row { display: grid; grid-template-columns: 36px 1fr auto; gap: 12px; align-items: center; padding: 12px; background: rgba(255,255,255,.04); border-radius: 16px; }
.rank { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,.08); color: var(--muted); font-weight: 900; }
.team-row small { display: block; color: var(--muted); }
.article-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.article-list a { display: block; padding: 13px; border-radius: 14px; background: rgba(255,255,255,.04); color: var(--text); font-weight: 800; }
.article-list a:hover { background: rgba(255,255,255,.08); }
.ad-box { text-align: center; padding: 26px; color: var(--muted); border-style: dashed; box-shadow: none; }
.ad-box span { display: block; color: var(--text); font-weight: 900; }
.ad-box.small { margin-top: 18px; min-height: 160px; display: grid; place-items: center; }
.site-footer { border-top: 1px solid var(--line); padding: 34px 0; color: var(--muted); }
.footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.disclaimer { font-size: .92rem; }
.article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; }
.article-main { max-width: 820px; }
.article-main.narrow { max-width: 820px; }
.article-main p { color: var(--muted); }
.article-page h1 { font-size: clamp(2.1rem, 4vw, 3.7rem); }
.match-summary-card { display: grid; grid-template-columns: 1fr auto 1fr; gap: 22px; align-items: center; padding: 24px; margin: 26px 0; }
.match-summary-card > div:not(.vs-badge) { padding: 18px; border-radius: 18px; background: rgba(255,255,255,.04); }
.vs-badge { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--accent); color: #07111f; font-weight: 1000; }
.big-score { display: block; font-size: 2.4rem; line-height: 1; color: var(--accent); }
.insight-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 20px 0 28px; }
.insight { padding: 16px; border-radius: 16px; background: rgba(255,255,255,.05); }
.insight span { display: block; color: var(--muted); font-size: .82rem; font-weight: 800; }
.insight strong { display: block; margin-top: 8px; }
.data-table { width: 100%; border-collapse: collapse; overflow: hidden; border-radius: 18px; background: rgba(255,255,255,.04); }
.data-table th, .data-table td { padding: 13px 14px; border-bottom: 1px solid var(--line); text-align: left; }
.data-table th { color: var(--muted); font-size: .86rem; text-transform: uppercase; letter-spacing: .08em; }
.data-table tr:last-child td { border-bottom: 0; }
.data-table.wide { margin-top: 24px; }
.sidebar .sticky { position: sticky; top: 94px; }
.metric-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
.metric-list li { display: flex; justify-content: space-between; gap: 10px; padding: 12px; background: rgba(255,255,255,.04); border-radius: 14px; }
.metric-list span { color: var(--muted); }
.team-header { display: grid; grid-template-columns: 1fr 180px; gap: 24px; align-items: center; }
.radar-score { display: grid; place-items: center; width: 170px; height: 170px; border-radius: 42px; background: linear-gradient(135deg, rgba(74,222,128,.18), rgba(56,189,248,.14)); border: 1px solid var(--line); }
.radar-score strong { font-size: 4rem; line-height: 1; }
.radar-score span { color: var(--muted); font-weight: 900; }
.form-strip { display: flex; gap: 8px; margin: 18px 0; }
.form-strip span { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: var(--accent); color: #07111f; font-weight: 1000; }
@media (max-width: 900px) {
  .hero-grid, .two-col, .article-layout, .footer-grid, .team-header { grid-template-columns: 1fr; }
  .match-grid { grid-template-columns: 1fr; }
  .insight-grid { grid-template-columns: 1fr 1fr; }
  .main-nav { overflow-x: auto; padding-bottom: 4px; }
  .nav-wrap { align-items: flex-start; flex-direction: column; padding: 16px 0; }
  .radar-score { width: 140px; height: 140px; }
}
@media (max-width: 560px) {
  .score-row, .match-summary-card, .insight-grid { grid-template-columns: 1fr; }
  .vs-badge { margin: 0 auto; }
  .section-head { align-items: start; flex-direction: column; }
}
