  "history": [
    {
      "text": "Liverpool FC, 15 Mart 1892'de Everton yönetimiyle yollarını ayıran kurucu John Houlding ve arkadaşları tarafından Anfield'da kuruldu; kulüp resmî olarak 3 Haziran 1892'de Board of Trade onayıyla tescil edildi.",
      "source": [
        "lfcFounded"
      ]
    },
    {
      "text": "Anfield'ı daha önce Everton kullanıyordu; ayrılık sonrası Everton yakındaki Mere Green Field'a (sonraki Goodison Park) taşındı ve Houlding boş kalan stat için yeni kulübü kurdu.",
      "source": [
        "lfcFounded"
      ]
    },
    {
      "text": "Kulübün ilk maçı 1 Eylül 1892'de Anfield'da Rotherham Town'a karşı 7-1 kazanılan hazırlık maçıydı.",
      "source": [
        "lfcBirthday"
      ]
    },
    {
      "text": "Liverpool ilk sezonu olan 1892-93'ü Lancashire League şampiyonu olarak bitirdi; 1893-94, 1895-96, 1904-05 ve 1961-62'de ikinci lig (Division Two) şampiyonluğu kazandı. 1961-62'deki dönüşü Bill Shankly yönetti.",
      "source": [
        "lfcHonours"
      ]
    },
    {
      "text": "Bill Shankly ilk FA Cup'ı 1965'te getirdi; halefi Bob Paisley üç Avrupa Kupası kazandı, Joe Fagan 1984'te dördüncüyü ekledi.",
      "source": [
        "lfcHonours"
      ]
    },
    {
      "text": "Rafael Benítez yönetiminde 2005'te İstanbul'da oynanan final 'İstanbul Mucizesi' olarak anılır; Jürgen Klopp 2019'da altıncı Avrupa Kupası'nı ve Aralık 2019'da kulübün ilk FIFA Kulüpler Dünya Kupası'nı kazandı.",
      "source": [
        "lfcHonours"
      ]
    },
    {
      "text": "Kulübün son lig şampiyonluğu, Arne Slot yönetiminde 2024-25 Premier Lig sezonunda geldi; bu, 20. lig şampiyonluğuydu.",
      "source": [
        "lfcHonours"
      ]
    }
  ],
  "honoursTotal": {
    "text": "Kulübün resmî sitesine göre Liverpool'un erkekler A takımında 52 büyük kupası var.",
    "source": [
      "lfcHonours"
    ]
  },
